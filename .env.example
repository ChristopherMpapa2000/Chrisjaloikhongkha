# =====================================================================
# แสงคงคา (Saeng Khongkha) — Environment Configuration
# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริงก่อนรันหรือ Deploy
# =====================================================================

# พอร์ตที่เซิร์ฟเวอร์เปิดใช้งาน (Cloud Host เช่น Railway/Render จะกำหนดให้อัตโนมัติ)
PORT=3000

# โดเมนจริงของเว็บ (ใช้สร้างลิงก์ภาพ og:image สำหรับแชร์ลง LINE / Facebook)
# เช่น https://loykrathong.yourdomain.com
PUBLIC_BASE_URL=

# =====================================================================
# ฐานข้อมูล Cloud: Supabase PostgreSQL (แนะนำสำหรับใช้งานจริง!)
# หาได้จาก: Supabase Dashboard -> Project Settings -> Data API / API Keys
# รองรับทั้ง Secret key รุ่นใหม่ (sb_secret_...) และ Legacy service_role key (eyJ...)
# หมายเหตุ: หากปล่อยว่างไว้ ระบบจะใช้ SQLite ในเครื่องแบบเริ่มจาก 0 อัตโนมัติ
# =====================================================================
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# =====================================================================
# ตัวเลือกสำหรับโหมดทดสอบเท่านั้น (ใช้งานจริงให้เป็น false เสมอ)
# =====================================================================
SEED_DEMO=false
